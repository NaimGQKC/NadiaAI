# === NadiaAI Environment Variables ===
# Copy this to .env and fill in your values:  cp .env.example .env
# NEVER commit .env to git (it's gitignored). These LOCAL values are not used by
# the GitHub Actions cron — that reads from GitHub repo Secrets instead.

# ── Extraction LLM (reads edict/obituary text → JSON) ──────────────────────
# Provider-neutral, OpenAI-compatible. Configured here for MiniMax via OpenRouter.
EXTRACTION_API_KEY=sk-or-your-openrouter-key-here
EXTRACTION_API_URL=https://openrouter.ai/api/v1/chat/completions
EXTRACTION_MODEL=minimax/minimax-m2
# Other MiniMax variants (base m2 = cheapest, m2.7 = most capable):
#   minimax/minimax-m2.1  |  minimax/minimax-m2.5  |  minimax/minimax-m2.7
# To use DeepSeek instead:
#   EXTRACTION_API_URL=https://api.deepseek.com/chat/completions
#   EXTRACTION_MODEL=deepseek-chat

# ── Contact-search LLM (name → web → contact path) ─────────────────────────
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here
# Optional overrides (defaults shown):
# PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
# PERPLEXITY_MODEL=sonar

# ── Cost / scope controls (optional) ───────────────────────────────────────
# Max leads to spend a paid contact-search on per run (default 50):
CONTACT_ENRICH_MAX_PER_RUN=50
# Geographic scope: `all` (whole of Spain) or a comma list e.g. `zaragoza,huesca`:
# NADIA_PROVINCES=all
# Per-run cap for the BOE office-contact backfill (one PDF fetch/lead; default 150):
# BOE_BACKFILL_MAX_PER_RUN=150
# Soft wall-clock budget in seconds; past it, heavy enrichment is skipped so the
# worklist email always sends. 0 disables the guard (default 1080 = 18 min):
# PIPELINE_SOFT_BUDGET_SECONDS=1080

# ── BOE access via proxy (optional) ────────────────────────────────────────
# boe.es blocks many datacenter / CI IPs at the TCP layer (connection times out,
# not a 403), so from GitHub Actions BOE can yield 0 leads — losing the highest
# heir-yield notarial/judicial cohort. Route BOE through a residential / Spain
# based proxy to restore access. Full proxy URL; unset = direct (default).
# For a socks5:// proxy, install the extra: pip install "requests[socks]".
# BOE_PROXY_URL=http://user:pass@host:port

# ── Not yet active (leave blank) ───────────────────────────────────────────
# EINFORMA_API_KEY=        # B2B registry enrichment — stub, not implemented
# PHANTOMBUSTER_API_KEY=   # legacy, superseded by the search waterfall

# ── Local infra (optional; sensible defaults exist) ────────────────────────
# NADIA_DB_PATH=nadia_ai.db
# DASHBOARD_PORT=5000
# PERSON_TTL_DAYS=730
# CATASTRO_CACHE_DAYS=30

# ── Ollama (only for the standalone qa_judge dev tool, not the pipeline) ────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ── INE calibration cron only (Google Sheets) — leave blank otherwise ──────
# GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json
# LEADS_SHEET_ID=your-google-sheet-id-here
